<https://wikisales.wikibase.cloud/entity/Q25> <label> "Compra de Leads Qualificados" .
<https://wikisales.wikibase.cloud/entity/Q25> <pai> "https://wikisales.wikibase.cloud/entity/Q2" .
<https://wikisales.wikibase.cloud/entity/Q25> <entidade controladora ou pai> "https://wikisales.wikibase.cloud/entity/Q2" .
<https://wikisales.wikibase.cloud/entity/Q25> <mãe> "https://wikisales.wikibase.cloud/entity/Q1" .
